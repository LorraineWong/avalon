{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z0-9]{4,8}$/)",
        "game": {
          ".write": "auth != null && $code.matches(/^[A-Z0-9]{4,8}$/) && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host', 'j']) && newData.child('host').isString() && newData.child('j').isString() && newData.child('j').val().length < 200000 && (data.exists() || newData.child('host').val() === auth.uid)"
        },
        "seats": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/game/host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['j']) && newData.child('j').isString() && newData.child('j').val().length < 20000"
          }
        },
        "sec": {
          "$id": {
            ".write": "auth != null && root.child('rooms/' + $code + '/game/host').val() === auth.uid",
            ".validate": "newData.hasChildren(['j']) && newData.child('j').isString() && newData.child('j').val().length < 20000"
          }
        },
        "online": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() || newData.isBoolean()"
          }
        }
      }
    }
  }
}
